#!/usr/bin/env bash
# Git Pre-Push Hook - DNS Telemetry Pipeline
# Audits all commits in the push range before transmission to remote.
# Prevents accidental leak of restricted datasets, keys, or raw artifacts.
#
# Activation instruction:
#   git config core.hooksPath .githooks
set -e

# Select Python binary (venv or system python3)
if [ -f ".venv/bin/python" ]; then
    PYTHON=".venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON="python3"
elif command -v python >/dev/null 2>&1; then
    PYTHON="python"
else
    echo "ERROR: Python interpreter not found." >&2
    exit 1
fi

echo "Running pre-push data protection and commit range audit..."

z40="0000000000000000000000000000000000000000"

if [ -t 0 ]; then
    # Running interactively without piped stdin
    $PYTHON scripts/data_protection_check.py --stage pre-push --local-ref "HEAD"
else
    # Git executes hook by piping lines into stdin:
    # <local_ref> <local_oid> <remote_ref> <remote_oid>
    has_input=0
    while read -r local_ref local_oid remote_ref remote_oid; do
        has_input=1
        if [ "$local_oid" = "$z40" ]; then
            # Branch is being deleted on remote, skip
            continue
        fi

        $PYTHON scripts/data_protection_check.py \
            --stage pre-push \
            --local-ref "$local_oid" \
            --remote-ref "$remote_oid"
    done

    if [ "$has_input" -eq 0 ]; then
        $PYTHON scripts/data_protection_check.py --stage pre-push --local-ref "HEAD"
    fi
fi

echo "Pre-push verification passed successfully."
